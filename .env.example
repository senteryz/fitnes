# ─── Интеграция базы данных db.json через GitHub API ─────────────
# Получите токен на: https://github.com/settings/tokens (classic repo или fine-grained Contents: read/write)
GITHUB_TOKEN=
GITHUB_REPO=senteryz/fitnes
GITHUB_BRANCH=main
GITHUB_PATH=data/db.json

# Порт локального сервера (по умолчанию 3000)
PORT=3000
